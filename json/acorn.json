        "response_type": "application/json",
        "status": "verified_200",
        "response_schema": {
          "type": "array"
        }
      },
      {
        "id": "get-enrolled-courses",
        "method": "GET",
        "path": "/enrolment/course/enrolled-courses",
        "purpose": "Enrolled, waitlisted, and dropped courses for one registration, including meeting times, rooms, and instructors.",
        "parameters": [
          {
            "name": "postCode",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Copied from eligible-registrations registrationParams.postCode."
          },
          {
            "name": "postDescription",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sessionCode",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Copied from registrationParams.sessionCode (e.g. 20269)."
          },
          {
            "name": "sessionDescription",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "assocOrgCode",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "acpDuration",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "levelOfInstruction",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "typeOfProgram",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "designationCode1",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "primaryOrgCode",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "secondaryOrgCode",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "collaborativeOrgCode",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "adminOrgCode",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "coSecondaryOrgCode",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "yearOfStudy",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "postAcpDuration",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "auth_required": true,
        "unauthenticated_behavior": "Returns HTTP 302 redirecting to https://idpz.utorauth.utoronto.ca/idp/profile/SAML2/Redirect/SSO",
        "response_type": "application/json",
        "status": "verified_200",
        "notes": "Query fields are copied from registrationParams on an eligible-registrations item. Waitlist rank is often missing here; use /enrolment/course/view.",
        "response_schema": {
          "type": "object",
          "keys": {
            "APP": "array of course objects (enrolled)",
            "WAIT": "array of course objects (waitlisted)",
            "DROP": "array of course objects (dropped)"
          },
          "course": {
            "code": "string",
            "courseCode": "string",
            "sectionCode": "string",
            "title": "string",
            "name": "string",
            "status": "string",
            "sessionCode": "string",
            "waitlistSectionNo": "string",
            "waitlistMeetings": "string",
            "meetings": "array of meeting objects"
          },
          "meeting": {
            "sectionNo": "string",
            "displayName": "string",
            "teachMethod": "string",
            "displayTime": "string",
            "deliveryMode": "string",
            "commaSeparatedInstructorNames": "string",
            "waitlistRank": "integer or null",
            "enrollmentSpaceAvailable": "integer",
            "enrollSpace": "integer",
            "totalSpace": "integer",
            "times": "array of time slot objects",
            "meetingResources": "array of instructor resource objects"
          },
          "time_slot": {
            "day": {
              "dayCode": "string",
              "dayName": "string"
            },
            "startTime": "string",
            "endTime": "string",
            "buildingCode": "string",
            "room": "string",
            "instructors": "array of string"
          },
          "meeting_resource": {
            "instructorFirstName": "string",
            "instructorSurname": "string"
          }
        }
