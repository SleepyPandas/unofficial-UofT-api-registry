      {
        "id": "get-enrolment-plan",
        "method": "GET",
        "path": "/enrolment/plan",
        "purpose": "Courses in the enrolment cart (planned, not yet enrolled).",
        "parameters": [
          {
            "name": "candidacyPostCode",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "From an eligible-registrations item."
          },
          {
            "name": "candidacySessionCode",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "From an eligible-registrations item."
          },
          {
            "name": "sessionCode",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "From registrationParams.sessionCode."
          }
        ],
        "auth_required": true,
        "unauthenticated_behavior": "Returns HTTP 302 redirecting to https://idpz.utorauth.utoronto.ca/idp/profile/SAML2/Redirect/SSO",
        "response_type": "application/json",
        "status": "verified_200",
        "response_schema": {
          "type": "array",
          "item": {
            "courseCode": "string",
            "sectionCode": "string",
            "activityChoices": "lecture, tutorial, and practical section numbers"
          }
        }
      },
      {
        "id": "get-course-view",
        "method": "GET",
        "path": "/enrolment/course/view",
        "purpose": "Single course/section detail, including waitlist rank and per-activity space.",
        "parameters": [
          {
            "name": "courseCode",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Course code from an enrolled-courses row (e.g. CSC209H1)."
          },
          {
            "name": "courseSessionCode",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Session code from the course row, else registrationParams.sessionCode."
          },
          {
            "name": "sectionCode",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Term section code (F, S, or Y)."
          },
          {
            "name": "subjectCode1",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "useSws",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "activityApprovedInd",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "activityApprovedOrg",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "auth_required": true,
        "unauthenticated_behavior": "Returns HTTP 302 redirecting to https://idpz.utorauth.utoronto.ca/idp/profile/SAML2/Redirect/SSO",
        "response_type": "application/json",
        "status": "verified_200",
        "notes": "Also send the same registrationParams query fields as /enrolment/course/enrolled-courses. Course payload is usually under responseObject and uses the same meeting/times shape as enrolled-courses. waitlistRank is populated here.",
        "response_schema": {
          "type": "object",
          "keys": {
            "responseObject": "course object (same fields as enrolled-courses course rows)"
          },
          "course": {
            "code": "string",
            "sectionCode": "string",
            "title": "string",
            "sessionCode": "string",
            "waitlistSectionNo": "string",
            "waitlistMeetings": "string",
            "meetings": "array of meeting objects with waitlistRank and times[]"
          }
        }
      },
