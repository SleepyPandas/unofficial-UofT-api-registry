{
  "api": {
    "id": "acorn",
    "name": "ACORN",
    "description": "U of T course enrolment portal (Student Web Services). After UTORauth SAML and Duo, the web client calls JSON routes under /sws/rest. This catalog covers GET reads only; enrolment mutation routes are not documented.",
    "base_url": "https://acorn.utoronto.ca/sws/rest",
    "human_url": "https://acorn.utoronto.ca/sws",
    "operator": "University of Toronto",
    "auth": "UTORid via UTORauth SAML SSO (idpz.utorauth.utoronto.ca) plus Duo MFA",
    "official_support": false,
    "read_only": true,
    "verified": "2026-09",
    "security_note": "Enrolment, financial, and identity data are highly sensitive. Credentials, session cookies, and student payloads must never be logged or committed. This catalog lists field names and types only.",
    "unauthenticated_behavior": "Returns HTTP 302 redirecting to https://idpz.utorauth.utoronto.ca/idp/profile/SAML2/Redirect/SSO",
    "endpoints": [
      {
